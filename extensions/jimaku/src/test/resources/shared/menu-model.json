{
  "note": "Written by Jimaku's extension/scripts/export-shared-cases.ts. Change the cases there, not here.",
  "about": "lib/menu-model.ts cases shared with the Android port: what Jimaku's subtitle menu lists for a video, and what its rows read and do. Each case changes the base input and checks what is given under expect; tests/menu-model.test.ts and the bundle's MenuModelTest run every case.",
  "format": {
    "input": "Changes to base, as MenuInput has them. me is the account's balance in seconds and whether it is signed in; trackUnknown: true stands for a track the player hasn't said yet (undefined).",
    "read": "A row as a viewer reads it: the name, ' ✦' on a Premium row, ': ' and the value where there is one, ' ✓' when checked. The main panel reads 'Premium on|off|signed out' and its value first, then the note in brackets or each row, then 'Other languages ›' where Other languages has anything.",
    "rows": "The main panel read whole.",
    "rowsAt": "The main panel read from index from: its next rows.length entries.",
    "mainRows": "The main panel's language rows read, without the switch or Other languages.",
    "main": "Fields of the main panel: signedIn, premium, value, note, other, original.",
    "row": "The first main row with that name has at least the fields under is; null means null, an object is matched the same way.",
    "other": "Other languages read, with no search: rows whole, start its first entries, has and lacks entries, lacksStarting no entry starting so.",
    "otherAll": "Every Other languages row has at least these fields.",
    "otherRow": "The first Other languages row in that language has at least the fields under is.",
    "otherCaption": "Other languages' caption.",
    "search": "Other languages read for what was typed.",
    "pick": "The version shown without being asked for, or null; exactly.",
    "plan": "How the subtitle would be made; exactly.",
    "mode": "The mode the Premium switch reads.",
    "questions": "Every question the menu could ask while open.",
    "minutesOwed": "The minutes a purchase must cover for the input's balance.",
    "percent": "Settings' sizes: value, then what it reads.",
    "seconds": "Settings' timing in seconds: value, then what it reads."
  },
  "base": {
    "lookup": null,
    "kept": [],
    "preferred": "en",
    "showing": null,
    "me": {
      "balance": 2760,
      "signedIn": true
    },
    "minutesKnown": true,
    "duration": 840,
    "track": "ja",
    "mode": null,
    "working": null
  },
  "cases": [
    {
      "name": "the Premium switch is on with the minutes left",
      "input": {},
      "expect": {
        "rowsAt": {
          "from": 0,
          "rows": [
            "Premium on: 46 min left"
          ]
        }
      }
    },
    {
      "name": "the Premium switch is off as Standard, free",
      "input": {
        "mode": "standard"
      },
      "expect": {
        "rowsAt": {
          "from": 0,
          "rows": [
            "Premium off: Standard, free"
          ]
        }
      }
    },
    {
      "name": "the Premium switch waits for sign-in without a value",
      "input": {
        "me": {
          "balance": 0,
          "signedIn": false
        }
      },
      "expect": {
        "rowsAt": {
          "from": 0,
          "rows": [
            "Premium signed out"
          ]
        }
      }
    },
    {
      "name": "the Premium switch is off signed out, whatever mode was chosen before",
      "input": {
        "me": {
          "balance": 0,
          "signedIn": false
        },
        "mode": "premium"
      },
      "expect": {
        "main": {
          "premium": false
        }
      }
    },
    {
      "name": "the Premium switch reads whole minutes rounded down: 0 seconds",
      "input": {
        "me": {
          "balance": 0,
          "signedIn": true
        },
        "mode": "premium"
      },
      "expect": {
        "main": {
          "value": "0 min left"
        },
        "minutesOwed": 0
      }
    },
    {
